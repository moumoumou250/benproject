# 环境变量与密钥（绝不提交）
.env

# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/

# 虚拟环境
.venv/

# Node 依赖（mcp_servers 下各服务器的 node_modules）
node_modules/

# 测试报告与轨迹（含执行证据，默认不提交；保留目录）
reports/*
!reports/.gitkeep

# 运行产物（每次扫描/测试生成，绝不入库）
strix_runs/*
!strix_runs/.gitkeep

# 工具缓存
.pytest_cache/
.ruff_cache/

# 系统/编辑器临时文件
.DS_Store
*.tmp

# Build outputs
build/
dist/

# Local RAG index
Ben/rag/vector_store/*.sqlite3*
.venv-interface-check/

.venv-rag/
.rag-*/
.rag-*.txt
