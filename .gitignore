# 环境变量与密钥（绝不提交）
.env

# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/

# 虚拟环境（含临时校验环境）
.venv/
.venv-*/

# Node 依赖（mcp_servers 下各服务器的 node_modules）
node_modules/

# 运行产物统一根：扫描记录、报告、工具缓存全部落在这里（绝不入库）
_artifacts/

# 历史产物目录（旧版本把产物直接放在仓库根；保留兼容读取，仍不入库）
reports/*
!reports/.gitkeep
strix_runs/*
!strix_runs/.gitkeep

# 工具缓存（已改到 _artifacts/cache，保留旧路径忽略以防万一）
.pytest_cache/
.ruff_cache/
# 有人用 --basetemp 把 pytest 临时目录放进仓库时留下的产物
pytest-of-*/

# 系统/编辑器临时文件
.DS_Store
*.tmp

# Build outputs
build/
dist/

# Local RAG index
Ben/rag/vector_store/*.sqlite3*

# 一次性 RAG 安装实验产物（uv export / 临时依赖目录），用完即删
.rag-*/
.rag-*.txt

# 信息收集产物（recon CLI；含目标响应原文，绝不入库）
recon/

# 临时校验环境（本地跑测试用，不入库）
.venv-verify/
.tmp-verify/

# 桌面回收站误入
.Trash-0/
