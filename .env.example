# ===== 大模型（OpenAI 兼容接口，当前默认接智谱 GLM）=====
# 复制本文件为 .env，填写真实 API Key；.env 不要提交到版本库。
# 智谱：在 https://bigmodel.cn 创建 API Key（id.secret 形式）
DEEPSEEK_API_KEY=在这里填入你的真实key
# 智谱免费模型，function calling 经实测稳定；也可换 glm-4.6 等
DEEPSEEK_MODEL=glm-5.3-flash
# 智谱 OpenAI 兼容入口
DEEPSEEK_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# —— 若改用 DeepSeek，把上面两行改为：
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# 单次模型请求超时（秒）
LLM_TIMEOUT=60
# Agent 最大决策轮数（防止无限循环）
MAX_AGENT_TURNS=12

# ===== 授权目标白名单（逗号分隔）=====
# 只有命中白名单的目标才允许工具访问；其余地址一律拒绝。
# 靶场容器与执行容器在同一个 Docker 网络中，用容器名访问。
ALLOWED_TARGETS=http://juice-shop:3000

# ===== Docker 执行器 =====
EXECUTOR_IMAGE=ghcr.io/usestrix/strix-sandbox:1.3.0
EXECUTOR_NETWORK=benptnet
EXECUTOR_CONTAINER=benpt-executor
# 单条容器命令超时（秒）
COMMAND_TIMEOUT=30
