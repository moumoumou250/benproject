# Model switch: keep exactly one active LLM_MODEL line.
# ChatGPT subscription (run: python main.py auth login chatgpt):
LLM_MODEL=chatgpt
# chatgpt is shorthand for chatgpt/gpt-6.1-sol; specify another available model explicitly:
# LLM_MODEL=chatgpt/gpt-6.1-sol
# Grok Build (uses the `grok login` session in ~/.grok/auth.json, not an xAI API key):
# LLM_MODEL=grok
# grok is shorthand for grok/grok-4.6. xai/grok-* stays on api.x.ai and needs XAI_API_KEY.
# Moonshot / Kimi (LiteLLM provider routing):
# LLM_MODEL=moonshot/kimi-k2.6
# Other providers remain supported, e.g. deepseek/, anthropic/, gemini/, openrouter/.
# Configure each provider's own API key when switching to it.
# Keep generic credentials/endpoint empty so they do not override provider routing.
LLM_API_KEY=
LLM_API_BASE=
MOONSHOT_API_KEY=
MOONSHOT_API_BASE=https://api.moonshot.cn/v1
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# 单次模型请求超时（秒）
LLM_TIMEOUT=60
# Agent 最大决策轮数（防止无限循环）
MAX_AGENT_TURNS=12

# ===== 授权目标白名单（逗号分隔）=====
# 只有命中白名单的目标才允许工具访问；其余地址一律拒绝。
# 靶场容器与执行容器在同一个 Docker 网络中，用容器名访问。
ALLOWED_TARGETS=http://juice-shop:3000

# ===== Docker 执行器 =====
EXECUTOR_IMAGE=ghcr.io/usestrix/strix-sandbox:1.4.0
EXECUTOR_NETWORK=benptnet
EXECUTOR_CONTAINER=benpt-executor
# 单条容器命令超时（秒）
COMMAND_TIMEOUT=30

# ===== MCP（可选，不配置则不加载任何 MCP 连接）=====
# MCP 配置文件路径；不填时默认读取 ~/.ben/mcp-servers.json
# BEN_MCP_CONFIG=C:/path/to/mcp-servers.json

# RAG: local 无需密钥；openai 使用独立 Embedding 服务（不复用聊天模型）
BEN_RAG_EMBEDDING_PROVIDER=local
# BEN_RAG_EMBEDDING_MODEL=text-embedding-3-small
# BEN_RAG_EMBEDDING_API_KEY=
# BEN_RAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
# BEN_RAG_KNOWLEDGE_DIR=C:/path/to/knowledge
# BEN_RAG_DATABASE=C:/path/to/knowledge.sqlite3
BEN_RAG_CHUNK_SIZE=1000
BEN_RAG_CHUNK_OVERLAP=150
