# ===== 大模型（多厂商支持，厂商中立变量）=====
# 复制本文件为 .env，填写真实 API Key；.env 不要提交到版本库。
#
# ── 模式 A：OpenAI 兼容端点 ──────────────────────────────────
# 裸模型名 + LLM_API_BASE + LLM_API_KEY，适合智谱/KIMI/DeepSeek 官方兼容入口
LLM_MODEL=在这里填模型名，如 kimi-k2.6 或 glm-5.3-flash
LLM_API_KEY=在这里填入你的真实key
LLM_API_BASE=https://api.moonshot.cn/v1
#
# ── 模式 B：LiteLLM 多厂商路由 ───────────────────────────────
# 模型名带 厂商/ 前缀，走 LiteLLM 内置目录（100+ 厂商），LLM_API_BASE 留空
# LLM_MODEL=deepseek/deepseek-chat
# LLM_API_KEY=在这里填入你的真实key          # 通用 key，自动镜像到厂商变量
# 或配厂商专属 key（此时 LLM_API_KEY 可留空）：
# DEEPSEEK_API_KEY=sk-...
#
# 常用前缀：moonshot/ deepseek/ anthropic/ gemini/ openrouter/ vertex_ai/ ollama/
# 注意：部分厂商目录默认国际站端点，cn 区 key 需用厂商 *_API_BASE 覆盖，如：
# MOONSHOT_API_BASE=https://api.moonshot.cn/v1
#
# 历史别名仍兼容（优先级低于 LLM_*）：
# DEEPSEEK_MODEL / DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL

# 单次模型请求超时（秒）
LLM_TIMEOUT=60
# Agent 最大决策轮数（防止无限循环）
MAX_AGENT_TURNS=12

# ===== 授权目标白名单（逗号分隔）=====
# 只有命中白名单的目标才允许工具访问；其余地址一律拒绝。
# 靶场容器与执行容器在同一个 Docker 网络中，用容器名访问。
ALLOWED_TARGETS=http://juice-shop:3000

# ===== Docker 执行器 =====
EXECUTOR_IMAGE=ghcr.io/usestrix/strix-sandbox:1.3.0
EXECUTOR_NETWORK=benptnet
EXECUTOR_CONTAINER=benpt-executor
# 单条容器命令超时（秒）
COMMAND_TIMEOUT=30

# ===== MCP（可选，不配置则不加载任何 MCP 连接）=====
# MCP 配置文件路径；不填时默认读取 ~/.ben/mcp-servers.json
# BEN_MCP_CONFIG=C:/path/to/mcp-servers.json
